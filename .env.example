# Frontend: leave empty when the API is reverse-proxied on the same origin.
VITE_API_BASE_URL=

# API secrets: replace every placeholder with a random secret of at least 32 characters.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://focus_force:replace-me@localhost:5432/focus_force?schema=public
FRONTEND_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CSRF_SECRET=replace-with-another-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379
TRUST_PROXY_HOPS=0

# Optional delivery providers. Telegram webhook must be configured with this secret.
SMTP_URL=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
